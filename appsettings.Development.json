{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SQPortal;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  // Local debug binding. Defined here rather than in Properties/launchSettings.json
  // because this takes effect however the app is started — F5, dotnet run, or the
  // built executable — and endpoints defined here override any launch profile.
  // Port 0 lets the operating system pick a free port, which always binds; the
  // chosen address is printed as "Now listening on ..." in the Output window.
  // This file is Development-only and is never used in UAT or production.
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:8085"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
