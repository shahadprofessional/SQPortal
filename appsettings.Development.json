{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SQPortal;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  // No HTTPS endpoint locally, so the https redirect is switched off to keep
  // the log clean. Servers keep the default of true.
  "Security": {
    "RequireHttps": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
