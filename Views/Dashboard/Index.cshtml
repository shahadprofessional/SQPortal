@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    bool IsRepeat(FeedbackCase c)
    {
        var phone = (c.CustomerPhone ?? "").Trim();
        if (!string.IsNullOrEmpty(phone) && Model.FlaggedPhones.Contains(phone)) return true;
        var name = (c.CustomerName ?? "").Trim().ToLowerInvariant();
        return !string.IsNullOrEmpty(name) && Model.FlaggedNames.Contains(name);
    }
    string PartnerEmail(string? partner)
    {
        if (string.IsNullOrEmpty(partner)) return string.Empty;
        return Model.PartnerEmails.TryGetValue(partner, out var e) ? e : string.Empty;
    }
    string PartnerFullName(string? partner)
    {
        if (string.IsNullOrEmpty(partner)) return string.Empty;
        return Model.PartnerFullNames.TryGetValue(partner, out var n) ? n : string.Empty;
    }
}

<h1 class="h3 mb-3">Dashboard <span class="text-muted fs-6">@Model.Today.ToString("yyyy-MM-dd")</span></h1>

<div class="row g-2 mb-4">
    @{
        var stats = new (string Label, int Value, string Accent)[]
        {
            ("Total",         Model.Total,       "accent-navy"),
            ("This month",    Model.Month,       "accent-navy"),
            ("Pending",       Model.Pending,     "accent-amber"),
            ("SLA breached",  Model.Breached,    Model.Breached > 0 ? "accent-red" : "accent-green"),
            ("Completed",     Model.Done,        "accent-green"),
            ("Valid",         Model.Valid,       "accent-green"),
            ("Not valid",     Model.NotValid,    "accent-gray"),
            ("Under review",  Model.UnderReview, "accent-indigo"),
            ("Staff issues",  Model.StaffIssues, "accent-orange"),
            ("Branch issues", Model.BranchIssues,"accent-orange"),
        };
    }
    @foreach (var s in stats)
    {
        <div class="col-6 col-md-3 col-lg-2">
            <div class="stat-card @s.Accent">
                <div class="stat-value">@s.Value</div>
                <div class="stat-label">@s.Label</div>
            </div>
        </div>
    }
</div>

@if (Model.RepeatCustomers.Any())
{
    <div class="card mb-4" style="border-left: 4px solid #FCD34D;">
        <div class="card-body py-2">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <strong class="me-2 text-sq-navy">🔄 Repeat customers</strong>
                @foreach (var r in Model.RepeatCustomers)
                {
                    <span class="repeat-pill">
                        <span>@r.Label</span>
                        <span class="repeat-pill-sub">@r.Sub</span>
                        <span class="repeat-pill-count">@r.Count</span>
                    </span>
                }
            </div>
        </div>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h5 mb-0">Urgent <span class="text-muted small">(@Model.Urgent.Count)</span></h2>
</div>
@if (!Model.Urgent.Any())
{
    <div class="sq-empty sq-empty-success mb-4">
        <div class="sq-empty-emoji">✅</div>
        <div class="sq-empty-title">No urgent cases</div>
        <div class="sq-empty-sub">Nothing overdue or due today.</div>
    </div>
}
else
{
    @Html.AntiForgeryToken()
    <div class="table-responsive bg-white rounded shadow-sm mb-4 border-start border-danger border-4">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Phone</th>
                    <th>Branch</th>
                    <th class="text-center">Branch ★</th>
                    <th>Staff</th>
                    <th>Partner</th>
                    <th>SLA</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Urgent)
                {
                    var c = row.Case;
                    var partnerEmail = PartnerEmail(c.BusinessPartner);
                    var partnerFullName = PartnerFullName(c.BusinessPartner);
                    var mailto = string.IsNullOrEmpty(partnerEmail) ? string.Empty : DisplayHelpers.BuildLowRatingMailto(c, partnerEmail, partnerFullName);
                    var rowClasses = (row.SlaBreached ? "tr-breached" : "") + (IsRepeat(c) ? " tr-repeat" : "");
                    <tr data-case-id="@c.Id" class="@rowClasses.Trim()">
                        <td class="text-monospace small">@DisplayHelpers.ShortId(c.Id)</td>
                        <td>@c.Date.ToString("yyyy-MM-dd")</td>
                        <td>
                            @c.CustomerName
                            @if (IsRepeat(c))
                            {
                                <span class="repeat-marker" title="Repeat customer">🔄</span>
                            }
                        </td>
                        <td>@c.CustomerPhone</td>
                        <td>@c.Branch</td>
                        <td class="text-center">@DisplayHelpers.Stars(c.BranchRating)</td>
                        <td>@c.StaffName</td>
                        <td>@c.BusinessPartner</td>
                        <td>
                            @if (row.SlaBreached)
                            {
                                <span class="badge-sq badge-sq-breached">Breached</span>
                            }
                            else
                            {
                                <span class="badge-sq badge-sq-pending">Due @c.DueDate.ToString("MM-dd")</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Cases" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                            @if (!string.IsNullOrEmpty(mailto))
                            {
                                <a class="btn btn-sm btn-outline-primary js-email-btn @(c.EmailSent ? "btn-email-sent" : "")"
                                   href="@mailto" data-case-id="@c.Id" title="@(c.EmailSent ? "Email already sent" : "Send partner email")">
                                    @(c.EmailSent ? "✓ Email" : "📧 Email")
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h5 mb-0">Recent</h2>
    <a class="small" asp-controller="Cases" asp-action="Index">View all cases &rarr;</a>
</div>
@if (!Model.Recent.Any())
{
    <div class="sq-empty">
        <div class="sq-empty-emoji">📋</div>
        <div class="sq-empty-title">No cases yet</div>
        <div class="sq-empty-sub"><a asp-controller="Cases" asp-action="Create">Add the first one</a> to get started.</div>
    </div>
}
else
{
    <div class="table-responsive bg-white rounded shadow-sm">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Branch</th>
                    <th class="text-center">Branch ★</th>
                    <th class="text-center">Staff ★</th>
                    <th>Status</th>
                    <th class="text-end">Age</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Recent)
                {
                    var c = row.Case;
                    var rowClasses = IsRepeat(c) ? "tr-repeat" : "";
                    <tr class="@rowClasses">
                        <td>@c.Date.ToString("yyyy-MM-dd")</td>
                        <td>
                            @c.CustomerName
                            @if (IsRepeat(c))
                            {
                                <span class="repeat-marker" title="Repeat customer">🔄</span>
                            }
                        </td>
                        <td>@c.Branch</td>
                        <td class="text-center">@DisplayHelpers.Stars(c.BranchRating)</td>
                        <td class="text-center">@DisplayHelpers.Stars(c.StaffRating)</td>
                        <td>
                            <span class="badge-sq @(c.FollowUpStatus == FollowUpStatus.Completed ? "badge-sq-completed" : "badge-sq-pending")">
                                @c.FollowUpStatus
                            </span>
                        </td>
                        <td class="text-end">@row.AgeDays d</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Cases" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
<script>
    (function () {
        var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
        if (!tokenEl) return;
        var token = tokenEl.value;
        document.querySelectorAll('.js-email-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = btn.getAttribute('data-case-id');
                if (!id) return;
                // Optimistic update — match the prototype's immediate-feedback behavior
                btn.classList.add('btn-email-sent');
                btn.textContent = '✓ Email';
                btn.setAttribute('title', 'Email already sent');
                var body = new URLSearchParams({ id: id, __RequestVerificationToken: token });
                fetch('@Url.Action("MarkEmailSent", "Cases")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: body.toString()
                }).catch(function () {});
            });
        });
    })();
</script>
}
