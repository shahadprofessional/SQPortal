@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    string PartnerEmail(string? partner)
    {
        if (string.IsNullOrEmpty(partner)) return string.Empty;
        return Model.PartnerEmails.TryGetValue(partner, out var e) ? e : string.Empty;
    }
    string PartnerFullName(string? partner)
    {
        if (string.IsNullOrEmpty(partner)) return string.Empty;
        return Model.PartnerFullNames.TryGetValue(partner, out var n) ? n : string.Empty;
    }

    // The selected card plus the active filters — what "the list you're looking at" means.
    Dictionary<string, string> FilterRoute()
    {
        var data = new Dictionary<string, string> { ["card"] = Model.SelectedCard };
        if (!string.IsNullOrWhiteSpace(Model.Search)) data["search"] = Model.Search;
        if (!string.IsNullOrWhiteSpace(Model.Month)) data["month"] = Model.Month;
        if (Model.Status.HasValue) data["status"] = Model.Status.Value.ToString();
        if (!string.IsNullOrWhiteSpace(Model.RootCause)) data["rootCause"] = Model.RootCause;
        return data;
    }

    // Same, with a page — ready for asp-all-route-data on the pagination links.
    Dictionary<string, string> RouteFor(int page)
    {
        var data = FilterRoute();
        data["page"] = page.ToString();
        return data;
    }

    // The three headline counters lead; the rest ride underneath as a minor row.
    var heroKeys = new[] { DashboardCards.Total, DashboardCards.Pending, DashboardCards.Breached };
    var heroCards = Model.Cards.Where(c => heroKeys.Contains(c.Key)).ToList();
    var minorCards = Model.Cards.Where(c => !heroKeys.Contains(c.Key)).ToList();

    string HeroTone(string key) =>
        key == DashboardCards.Breached ? "is-alert" :
        key == DashboardCards.Pending ? "is-warn" : "";

    var returnUrl = Url.Action("Index", "Dashboard", new
    {
        card = Model.SelectedCard,
        search = Model.Search,
        month = Model.Month,
        status = Model.Status,
        rootCause = Model.RootCause,
        page = Model.Page
    });
}

<div class="sq-page-head">
    <div>
        <div class="sq-kicker">Service quality</div>
        <h1 class="sq-title">Dashboard</h1>
    </div>
    <div class="sq-page-meta">@Model.Today.ToString("yyyy-MM-dd") · @Model.TotalItems cases in view</div>
</div>

<div class="d-flex justify-content-end align-items-center gap-3 flex-wrap mb-3">
    <a class="btn btn-outline-secondary" asp-action="ExportCsv" asp-all-route-data="@FilterRoute()">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 11l5 5 5-5M4 21h16"></path></svg>
        Export CSV
    </a>
    <a class="btn btn-primary" asp-controller="Cases" asp-action="Create">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"></path></svg>
        New case
    </a>
</div>

<div class="sq-hero-grid">
    @foreach (var card in heroCards)
    {
        var heroClasses = "sq-hero sq-frame " + HeroTone(card.Key) + (card.IsSelected ? " is-selected" : "");
        <a class="@heroClasses"
           asp-action="Index"
           asp-route-card="@card.Key"
           asp-route-search="@Model.Search"
           asp-route-month="@Model.Month"
           asp-route-status="@Model.Status"
           asp-route-rootCause="@Model.RootCause"
           title="@card.Hint"
           aria-current="@(card.IsSelected ? "true" : null)">
            <div class="sq-hero-top">
                <span class="sq-hero-value">@card.Value</span>
                <span class="sq-hero-label">@card.Label</span>
            </div>
            <div class="sq-hero-hint">@card.Hint</div>
        </a>
    }
</div>

<div class="sq-minor-grid">
    @foreach (var card in minorCards)
    {
        var minorClasses = "sq-minor" + (card.IsSelected ? " is-selected" : "");
        <a class="@minorClasses"
           asp-action="Index"
           asp-route-card="@card.Key"
           asp-route-search="@Model.Search"
           asp-route-month="@Model.Month"
           asp-route-status="@Model.Status"
           asp-route-rootCause="@Model.RootCause"
           title="@card.Hint"
           aria-current="@(card.IsSelected ? "true" : null)">
            <span class="sq-minor-label">@card.Label</span>
            <span class="sq-minor-value">@card.Value</span>
        </a>
    }
</div>

<div class="sq-section-head">
    <h2 class="sq-section-title">
        @Model.SelectedCardLabel
        <span class="sq-count">(@Model.TotalItems)</span>
    </h2>
</div>

<form method="get" asp-action="Index" class="sq-filters">
    <input type="hidden" name="card" value="@Model.SelectedCard" />
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Search</label>
            <input class="form-control" name="search" value="@Model.Search" placeholder="Customer, phone, branch, staff, ticket" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Month</label>
            <select class="form-select" name="month">
                <option value="">All</option>
                @foreach (var m in Model.Months)
                {
                    if (m == Model.Month)
                    {
                        <option value="@m" selected>@DisplayHelpers.FormatMonth(m)</option>
                    }
                    else
                    {
                        <option value="@m">@DisplayHelpers.FormatMonth(m)</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Status</label>
            <select class="form-select" name="status">
                <option value="">All</option>
                @foreach (var status in Enum.GetValues<FollowUpStatus>())
                {
                    if (Model.Status == status)
                    {
                        <option value="@status" selected>@status</option>
                    }
                    else
                    {
                        <option value="@status">@status</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Root cause</label>
            <select class="form-select" name="rootCause">
                <option value="">All</option>
                @foreach (var r in Model.RootCauseOptions)
                {
                    if (r == Model.RootCause)
                    {
                        <option value="@r" selected>@r</option>
                    }
                    else
                    {
                        <option value="@r">@r</option>
                    }
                }
                @if (Model.RootCause == "Other")
                {
                    <option value="Other" selected>Other</option>
                }
                else
                {
                    <option value="Other">Other</option>
                }
            </select>
        </div>
        <div class="col-md-1 d-flex align-items-end">
            <button class="btn btn-primary w-100" type="submit">Filter</button>
        </div>
    </div>
    @if (Model.HasFilters)
    {
        <div class="sq-filters-foot">
            <a asp-action="Index" asp-route-card="@Model.SelectedCard">Clear filters</a>
        </div>
    }
</form>

@if (!Model.Items.Any())
{
    <div class="sq-empty">
        <svg class="sq-empty-icon" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4.3-4.3"></path></svg>
        <div class="sq-empty-title">Nothing in “@Model.SelectedCardLabel”</div>
        <div class="sq-empty-sub">Try another card, or clear the filters.</div>
    </div>
}
else
{
    @Html.AntiForgeryToken()
    <div class="sq-case-scroll">
        <table class="table table-hover align-middle mb-0 sq-case-table sq-centered">
            <colgroup>
                <col style="width: 76px;" />
                <col style="width: 96px;" />
                <col style="width: 160px;" />
                <col style="width: 130px;" />
                <col style="width: 190px;" />
                <col style="width: 96px;" />
                <col style="width: 100px;" />
                <col style="width: 284px;" />
            </colgroup>
            <thead>
                <tr>
                    <th>Case</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Branch</th>
                    <th>Root cause</th>
                    <th>Status</th>
                    <th>SLA</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    var c = row.Case;
                    var partnerEmail = PartnerEmail(c.BusinessPartner);
                    var partnerFullName = PartnerFullName(c.BusinessPartner);
                    var mailto = string.IsNullOrEmpty(partnerEmail) ? string.Empty : DisplayHelpers.BuildLowRatingMailto(c, partnerEmail, partnerFullName);
                    var rootCauses = c.RootCauses.Any() ? string.Join(", ", c.RootCauses) : "—";
                    var rowClasses = row.SlaBreached ? "tr-breached" : "";
                    <tr class="sq-row-pressable @rowClasses"
                        data-case-id="@c.Id"
                        data-case-label="@c.CaseNumber"
                        tabindex="0" role="button"
                        title="Open case">
                        <td class="sq-id">@c.CaseNumber</td>
                        <td class="sq-num text-nowrap">@c.Date.ToString("yyyy-MM-dd")</td>
                        <td>@c.CustomerName</td>
                        <td>@c.Branch</td>
                        <td class="sq-cell-muted">@rootCauses</td>
                        <td>
                            <span class="badge-sq @(c.FollowUpStatus == FollowUpStatus.Completed ? "badge-sq-completed" : "badge-sq-pending")">
                                @c.FollowUpStatus
                            </span>
                        </td>
                        <td>
                            @if (row.SlaBreached)
                            {
                                <span class="badge-sq badge-sq-breached">Breached</span>
                            }
                            else
                            {
                                <span class="sq-cell-muted sq-num text-nowrap">Due @c.DueDate.ToString("MM-dd")</span>
                            }
                        </td>
                        <td>
                            <div class="sq-row-actions">
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-controller="Cases" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                                <form asp-controller="Cases" asp-action="Delete" asp-route-id="@c.Id" method="post"
                                      onsubmit="return confirm('Delete this case? This cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                </form>
                                @if (!string.IsNullOrEmpty(mailto))
                                {
                                    <a class="btn btn-sm btn-outline-secondary js-email-btn @(c.EmailSent ? "btn-email-sent" : "")"
                                       href="@mailto" data-case-id="@c.Id"
                                       title="@(c.EmailSent ? "Email already sent" : "Send partner email")">
                                        @(c.EmailSent ? "Sent" : "Email")
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" type="button" disabled
                                            title="No partner email on file">Email</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
        <div class="sq-table-foot">
            Showing @Model.FirstItemOnPage–@Model.LastItemOnPage of @Model.TotalItems · press any record for the full case
        </div>
        @if (Model.TotalPages > 1)
        {
            var windowStart = Math.Max(1, Model.Page - 2);
            var windowEnd = Math.Min(Model.TotalPages, windowStart + 4);
            windowStart = Math.Max(1, windowEnd - 4);

            <nav aria-label="Case list pages" class="ms-auto">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-all-route-data="@RouteFor(Math.Max(1, Model.Page - 1))">Prev</a>
                    </li>

                    @if (windowStart > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-all-route-data="@RouteFor(1)">1</a>
                        </li>
                        if (windowStart > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                    }

                    @for (var p = windowStart; p <= windowEnd; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-all-route-data="@RouteFor(p)">@p</a>
                        </li>
                    }

                    @if (windowEnd < Model.TotalPages)
                    {
                        if (windowEnd < Model.TotalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-all-route-data="@RouteFor(Model.TotalPages)">@Model.TotalPages</a>
                        </li>
                    }

                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-all-route-data="@RouteFor(Math.Min(Model.TotalPages, Model.Page + 1))">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

<div class="modal fade" id="caseDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <span class="sq-modal-kicker">Case record</span>
                    <span id="caseDetailId"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="caseDetailBody"></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
        var token = tokenEl ? tokenEl.value : '';
        var markEmailUrl = '@Url.Action("MarkEmailSent", "Cases")';
        var detailsUrl = '@Url.Action("Details", "Cases")';
        // JSON-encoded: the URL carries & separators that HTML encoding would mangle.
        var returnUrl = @Json.Serialize(returnUrl ?? string.Empty);

        // Marks every button for this case — the row and the open dialog stay in step.
        function markEmailSent(id) {
            document.querySelectorAll('.js-email-btn[data-case-id="' + id + '"]').forEach(function (el) {
                el.classList.add('btn-email-sent');
                el.textContent = 'Sent';
                el.setAttribute('title', 'Email already sent');
            });
        }

        function bindEmailButtons(root) {
            root.querySelectorAll('.js-email-btn').forEach(function (btn) {
                if (btn.dataset.bound) return;
                btn.dataset.bound = '1';
                btn.addEventListener('click', function () {
                    var id = btn.getAttribute('data-case-id');
                    if (!id || !token) return;
                    // Optimistic update — match the prototype's immediate-feedback behavior
                    markEmailSent(id);
                    var body = new URLSearchParams({ id: id, __RequestVerificationToken: token });
                    fetch(markEmailUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: body.toString()
                    }).catch(function () { /* leave UI optimistic; will reconcile on next page load */ });
                });
            });
        }

        // Pressable records — the whole case opens in a dialog.
        var modalEl = document.getElementById('caseDetailModal');
        var bodyEl = document.getElementById('caseDetailBody');
        var labelEl = document.getElementById('caseDetailId');

        function openCase(tr) {
            if (!modalEl || !window.bootstrap) return;
            var id = tr.getAttribute('data-case-id');
            if (!id) return;

            labelEl.textContent = '#' + (tr.getAttribute('data-case-label') || '');
            bodyEl.innerHTML = '<div class="text-center text-muted py-5">Loading…</div>';
            bootstrap.Modal.getOrCreateInstance(modalEl).show();

            var url = detailsUrl
                + '?id=' + encodeURIComponent(id)
                + '&partial=true'
                + '&returnUrl=' + encodeURIComponent(returnUrl);

            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (r) {
                    if (!r.ok) throw new Error(r.status);
                    return r.text();
                })
                .then(function (html) {
                    bodyEl.innerHTML = html;
                    bindEmailButtons(bodyEl);
                })
                .catch(function () {
                    bodyEl.innerHTML = '<div class="text-danger py-4 text-center">Could not load this case. Please try again.</div>';
                });
        }

        document.querySelectorAll('tr.sq-row-pressable').forEach(function (tr) {
            tr.addEventListener('click', function (e) {
                // Let the row's own buttons/links win.
                if (e.target.closest('a, button, form, input')) return;
                openCase(tr);
            });
            tr.addEventListener('keydown', function (e) {
                if (e.target !== tr) return;
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    openCase(tr);
                }
            });
        });

        bindEmailButtons(document);
    })();
</script>
}
