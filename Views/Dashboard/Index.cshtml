@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    bool IsRepeat(FeedbackCase c)
    {
        var phone = (c.CustomerPhone ?? "").Trim();
        if (!string.IsNullOrEmpty(phone) && Model.FlaggedPhones.Contains(phone)) return true;
        var name = (c.CustomerName ?? "").Trim().ToLowerInvariant();
        return !string.IsNullOrEmpty(name) && Model.FlaggedNames.Contains(name);
    }
    string PartnerEmail(string? partner)
    {
        if (string.IsNullOrEmpty(partner)) return string.Empty;
        return Model.PartnerEmails.TryGetValue(partner, out var e) ? e : string.Empty;
    }
    string PartnerFullName(string? partner)
    {
        if (string.IsNullOrEmpty(partner)) return string.Empty;
        return Model.PartnerFullNames.TryGetValue(partner, out var n) ? n : string.Empty;
    }

    // Card + active filters + page, ready for asp-all-route-data on the pagination links.
    Dictionary<string, string> RouteFor(int page)
    {
        var data = new Dictionary<string, string>
        {
            ["card"] = Model.SelectedCard,
            ["page"] = page.ToString()
        };
        if (!string.IsNullOrWhiteSpace(Model.Search)) data["search"] = Model.Search;
        if (!string.IsNullOrWhiteSpace(Model.Month)) data["month"] = Model.Month;
        if (Model.Status.HasValue) data["status"] = Model.Status.Value.ToString();
        if (!string.IsNullOrWhiteSpace(Model.RootCause)) data["rootCause"] = Model.RootCause;
        return data;
    }

    var returnUrl = Url.Action("Index", "Dashboard", new
    {
        card = Model.SelectedCard,
        search = Model.Search,
        month = Model.Month,
        status = Model.Status,
        rootCause = Model.RootCause,
        page = Model.Page
    });
}

<h1 class="h3 mb-3">Dashboard <span class="text-muted fs-6">@Model.Today.ToString("yyyy-MM-dd")</span></h1>

<div class="row g-2 mb-4">
    @foreach (var card in Model.Cards)
    {
        <div class="col-6 col-md-4 col-lg-3 col-xl-2">
            <a class="stat-card stat-card-link @card.Accent @(card.IsSelected ? "stat-card-active" : "")"
               asp-action="Index"
               asp-route-card="@card.Key"
               asp-route-search="@Model.Search"
               asp-route-month="@Model.Month"
               asp-route-status="@Model.Status"
               asp-route-rootCause="@Model.RootCause"
               title="@card.Hint"
               aria-current="@(card.IsSelected ? "true" : null)">
                <div class="stat-value">@card.Value</div>
                <div class="stat-label">@card.Label</div>
            </a>
        </div>
    }
</div>

@if (Model.RepeatCustomers.Any())
{
    <div class="card mb-4" style="border-left: 4px solid #FCD34D;">
        <div class="card-body py-2">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <strong class="me-2 text-sq-navy">🔄 Repeat customers</strong>
                @foreach (var r in Model.RepeatCustomers)
                {
                    <span class="repeat-pill">
                        <span>@r.Label</span>
                        <span class="repeat-pill-sub">@r.Sub</span>
                        <span class="repeat-pill-count">@r.Count</span>
                    </span>
                }
            </div>
        </div>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h5 mb-0">
        @Model.SelectedCardLabel
        <span class="text-muted small">(@Model.TotalItems)</span>
    </h2>
    <a class="small" asp-controller="Cases" asp-action="Index">Open in Cases &rarr;</a>
</div>

<form method="get" asp-action="Index" class="card card-body mb-3">
    <input type="hidden" name="card" value="@Model.SelectedCard" />
    <div class="row g-2">
        <div class="col-md-4">
            <label class="form-label small text-muted">Search</label>
            <input class="form-control" name="search" value="@Model.Search" placeholder="Search" />
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">Month</label>
            <select class="form-select" name="month">
                <option value="">All</option>
                @foreach (var m in Model.Months)
                {
                    if (m == Model.Month)
                    {
                        <option value="@m" selected>@DisplayHelpers.FormatMonth(m)</option>
                    }
                    else
                    {
                        <option value="@m">@DisplayHelpers.FormatMonth(m)</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">Status</label>
            <select class="form-select" name="status">
                <option value="">All</option>
                @foreach (var status in Enum.GetValues<FollowUpStatus>())
                {
                    if (Model.Status == status)
                    {
                        <option value="@status" selected>@status</option>
                    }
                    else
                    {
                        <option value="@status">@status</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted">Root cause</label>
            <select class="form-select" name="rootCause">
                <option value="">All</option>
                @foreach (var r in Model.RootCauseOptions)
                {
                    if (r == Model.RootCause)
                    {
                        <option value="@r" selected>@r</option>
                    }
                    else
                    {
                        <option value="@r">@r</option>
                    }
                }
                @if (Model.RootCause == "Other")
                {
                    <option value="Other" selected>Other</option>
                }
                else
                {
                    <option value="Other">Other</option>
                }
            </select>
        </div>
        <div class="col-md-1 d-flex align-items-end">
            <button class="btn btn-primary w-100" type="submit">Filter</button>
        </div>
    </div>
    @if (Model.HasFilters)
    {
        <div class="mt-2">
            <a asp-action="Index" asp-route-card="@Model.SelectedCard" class="small">Clear filters</a>
        </div>
    }
</form>

@if (!Model.Items.Any())
{
    <div class="sq-empty">
        <div class="sq-empty-emoji">🔍</div>
        <div class="sq-empty-title">No cases in “@Model.SelectedCardLabel”</div>
        <div class="sq-empty-sub">Try another card, or clear the filters.</div>
    </div>
}
else
{
    @Html.AntiForgeryToken()
    <div class="sq-case-scroll bg-white rounded shadow-sm">
        <table class="table table-sm table-hover align-middle mb-0 sq-case-table sq-centered">
            <colgroup>
                <col style="width: 76px;" />
                <col style="width: 96px;" />
                <col style="width: 160px;" />
                <col style="width: 130px;" />
                <col style="width: 190px;" />
                <col style="width: 96px;" />
                <col style="width: 100px;" />
                <col style="width: 284px;" />
            </colgroup>
            <thead class="table-light">
                <tr>
                    <th>Case ID</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Branch</th>
                    <th>Root cause</th>
                    <th>Status</th>
                    <th>SLA</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    var c = row.Case;
                    var partnerEmail = PartnerEmail(c.BusinessPartner);
                    var partnerFullName = PartnerFullName(c.BusinessPartner);
                    var mailto = string.IsNullOrEmpty(partnerEmail) ? string.Empty : DisplayHelpers.BuildLowRatingMailto(c, partnerEmail, partnerFullName);
                    var rootCauses = c.RootCauses.Any() ? string.Join(", ", c.RootCauses) : "—";
                    var rowClasses = (row.SlaBreached ? "tr-breached" : "") + (IsRepeat(c) ? " tr-repeat" : "");
                    <tr class="sq-row-pressable @rowClasses.Trim()"
                        data-case-id="@c.Id"
                        data-case-label="@c.CaseNumber"
                        tabindex="0" role="button"
                        title="Open case (details coming soon)">
                        <td class="text-monospace">@c.CaseNumber</td>
                        <td class="text-nowrap">@c.Date.ToString("yyyy-MM-dd")</td>
                        <td>
                            @c.CustomerName
                            @if (IsRepeat(c))
                            {
                                <span class="repeat-marker" title="Repeat customer">🔄</span>
                            }
                        </td>
                        <td>@c.Branch</td>
                        <td class="small">@rootCauses</td>
                        <td>
                            <span class="badge-sq @(c.FollowUpStatus == FollowUpStatus.Completed ? "badge-sq-completed" : "badge-sq-pending")">
                                @c.FollowUpStatus
                            </span>
                        </td>
                        <td>
                            @if (row.SlaBreached)
                            {
                                <span class="badge-sq badge-sq-breached">Breached</span>
                            }
                            else
                            {
                                <span class="text-muted small text-nowrap">Due @c.DueDate.ToString("MM-dd")</span>
                            }
                        </td>
                        <td>
                            <div class="sq-row-actions">
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-controller="Cases" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                                <form asp-controller="Cases" asp-action="Delete" asp-route-id="@c.Id" method="post"
                                      onsubmit="return confirm('Delete this case? This cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                </form>
                                @if (!string.IsNullOrEmpty(mailto))
                                {
                                    <a class="btn btn-sm btn-outline-primary js-email-btn @(c.EmailSent ? "btn-email-sent" : "")"
                                       href="@mailto" data-case-id="@c.Id"
                                       title="@(c.EmailSent ? "Email already sent" : "Send partner email")">
                                        @(c.EmailSent ? "✓ Email" : "📧 Email")
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-primary" type="button" disabled
                                            title="No partner email on file">📧 Email</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
        <div class="small text-muted">
            Showing @Model.FirstItemOnPage–@Model.LastItemOnPage of @Model.TotalItems
        </div>
        @if (Model.TotalPages > 1)
        {
            var windowStart = Math.Max(1, Model.Page - 2);
            var windowEnd = Math.Min(Model.TotalPages, windowStart + 4);
            windowStart = Math.Max(1, windowEnd - 4);

            <nav aria-label="Case list pages" class="ms-auto">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-all-route-data="@RouteFor(Math.Max(1, Model.Page - 1))">Previous</a>
                    </li>

                    @if (windowStart > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-all-route-data="@RouteFor(1)">1</a>
                        </li>
                        if (windowStart > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                    }

                    @for (var p = windowStart; p <= windowEnd; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-all-route-data="@RouteFor(p)">@p</a>
                        </li>
                    }

                    @if (windowEnd < Model.TotalPages)
                    {
                        if (windowEnd < Model.TotalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-all-route-data="@RouteFor(Model.TotalPages)">@Model.TotalPages</a>
                        </li>
                    }

                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-all-route-data="@RouteFor(Math.Min(Model.TotalPages, Model.Page + 1))">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

<div class="modal fade" id="caseDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Case details <span class="text-muted" id="caseDetailId"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="caseDetailBody"></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
        var token = tokenEl ? tokenEl.value : '';
        var markEmailUrl = '@Url.Action("MarkEmailSent", "Cases")';
        var detailsUrl = '@Url.Action("Details", "Cases")';
        // JSON-encoded: the URL carries & separators that HTML encoding would mangle.
        var returnUrl = @Json.Serialize(returnUrl ?? string.Empty);

        // Marks every button for this case — the row and the open dialog stay in step.
        function markEmailSent(id) {
            document.querySelectorAll('.js-email-btn[data-case-id="' + id + '"]').forEach(function (el) {
                el.classList.add('btn-email-sent');
                el.textContent = '✓ Email';
                el.setAttribute('title', 'Email already sent');
            });
        }

        function bindEmailButtons(root) {
            root.querySelectorAll('.js-email-btn').forEach(function (btn) {
                if (btn.dataset.bound) return;
                btn.dataset.bound = '1';
                btn.addEventListener('click', function () {
                    var id = btn.getAttribute('data-case-id');
                    if (!id || !token) return;
                    // Optimistic update — match the prototype's immediate-feedback behavior
                    markEmailSent(id);
                    var body = new URLSearchParams({ id: id, __RequestVerificationToken: token });
                    fetch(markEmailUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: body.toString()
                    }).catch(function () { /* leave UI optimistic; will reconcile on next page load */ });
                });
            });
        }

        // Pressable records — the whole case opens in a dialog.
        var modalEl = document.getElementById('caseDetailModal');
        var bodyEl = document.getElementById('caseDetailBody');
        var labelEl = document.getElementById('caseDetailId');

        function openCase(tr) {
            if (!modalEl || !window.bootstrap) return;
            var id = tr.getAttribute('data-case-id');
            if (!id) return;

            labelEl.textContent = '#' + (tr.getAttribute('data-case-label') || '');
            bodyEl.innerHTML = '<div class="text-center text-muted py-5">Loading…</div>';
            bootstrap.Modal.getOrCreateInstance(modalEl).show();

            var url = detailsUrl
                + '?id=' + encodeURIComponent(id)
                + '&partial=true'
                + '&returnUrl=' + encodeURIComponent(returnUrl);

            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (r) {
                    if (!r.ok) throw new Error(r.status);
                    return r.text();
                })
                .then(function (html) {
                    bodyEl.innerHTML = html;
                    bindEmailButtons(bodyEl);
                })
                .catch(function () {
                    bodyEl.innerHTML = '<div class="text-danger py-4 text-center">Could not load this case. Please try again.</div>';
                });
        }

        document.querySelectorAll('tr.sq-row-pressable').forEach(function (tr) {
            tr.addEventListener('click', function (e) {
                // Let the row's own buttons/links win.
                if (e.target.closest('a, button, form, input')) return;
                openCase(tr);
            });
            tr.addEventListener('keydown', function (e) {
                if (e.target !== tr) return;
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    openCase(tr);
                }
            });
        });

        bindEmailButtons(document);
    })();
</script>
}
