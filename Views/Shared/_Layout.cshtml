<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SQPortal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    @{
        // No sign-in yet — fall back to a placeholder until authentication lands.
        var userName = !string.IsNullOrWhiteSpace(User?.Identity?.Name) ? User!.Identity!.Name! : "Guest";
        var initials = string.Concat(userName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])));
    }
    <nav class="navbar navbar-dark sq-navbar mb-4">
        <div class="container flex-column align-items-stretch">
            <div class="d-flex align-items-center justify-content-between w-100 sq-navbar-top">
                <a class="navbar-brand mb-0" asp-controller="Dashboard" asp-action="Index">SQPortal</a>
                <div class="sq-user" title="Signed in as @userName">
                    <span class="sq-user-avatar">@initials</span>
                    <span class="sq-user-name">@userName</span>
                </div>
            </div>
            <ul class="navbar-nav flex-row flex-wrap justify-content-center w-100 sq-navbar-tabs">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Dashboard" asp-action="Index">📊 Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Cases" asp-action="Index">
                        📋 Cases @await Component.InvokeAsync("CasesCount")
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Cases" asp-action="Create">➕ Add Case</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Analytics" asp-action="Index">📈 Analytics</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Weekly" asp-action="Index">💌 Weekly</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Settings" asp-action="Index">⚙ Settings</a>
                </li>
            </ul>
        </div>
    </nav>

    <main class="container pb-5">
        @RenderBody()
    </main>

    <div class="toast-container sq-toasts">
        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="toast align-items-center text-bg-success border-0 sq-auto-toast" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">✓ @statusMessage</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.toast.sq-auto-toast').forEach(function (el) {
                var t = new bootstrap.Toast(el, { delay: 3500 });
                t.show();
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
