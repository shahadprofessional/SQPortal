<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SQPortal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">SQPortal</a>
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Cases" asp-action="Index">Cases</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Cases" asp-action="Create">Add Case</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Analytics" asp-action="Index">Analytics</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Weekly" asp-action="Index">Weekly</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Settings" asp-action="Index">Settings</a>
                </li>
            </ul>
        </div>
    </nav>

    <main class="container pb-5">
        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
