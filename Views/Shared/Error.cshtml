@{
    ViewData["Title"] = "Error";
}

<div class="sq-empty">
    <svg class="sq-empty-icon" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v4M12 16h.01"></path></svg>
    <div class="sq-empty-title">Something went wrong</div>
    <div class="sq-empty-sub">The error has been logged. Please try again, or head back to the dashboard.</div>
    <a class="btn btn-primary mt-3" asp-controller="Dashboard" asp-action="Index">Back to dashboard</a>
</div>
