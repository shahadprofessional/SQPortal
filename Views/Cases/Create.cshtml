@model CaseFormViewModel
@{
    ViewData["Title"] = "Add Case";
    var today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
}

<div class="sq-page-head">
    <div>
        <div class="sq-kicker">New case</div>
        <h1 class="sq-title">Add new case</h1>
    </div>
    <div class="sq-page-meta">SLA: 1 working day from the feedback date</div>
</div>

@if (!string.IsNullOrEmpty(Model.DuplicateWarning))
{
    <div class="alert alert-warning">@Model.DuplicateWarning</div>
}

<form id="caseForm" asp-action="Create" method="post" novalidate>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger" id="validationSummary"></div>

    <div class="sq-panel sq-frame mb-4">
        <div class="sq-step">
            <span class="sq-step-num">01</span>
            <h2>Customer &amp; case</h2>
            <span class="sq-step-rule"></span>
        </div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="CustomerName" class="form-label"></label>
                <input asp-for="CustomerName" class="form-control js-letters-only"
                       pattern="[A-Za-z ]+" maxlength="200" required
                       data-error-label="Customer name"
                       title="Letters and spaces only" />
            </div>
            <div class="col-md-3">
                <label asp-for="CustomerPhone" class="form-label"></label>
                <input asp-for="CustomerPhone" class="form-control js-digits-only" id="customerPhone"
                       inputmode="numeric" pattern="[0-9]{8}" minlength="8" maxlength="8" required
                       data-error-label="Customer phone"
                       title="Exactly 8 digits" />
                <div id="dupWarning" class="text-warning small mt-1"></div>
            </div>
            <div class="col-md-2">
                <label asp-for="TicketNumber" class="form-label"></label>
                <input asp-for="TicketNumber" class="form-control js-digits-only"
                       inputmode="numeric" pattern="[0-9]*" maxlength="60"
                       data-error-label="Ticket number"
                       title="Digits only" />
            </div>
            <div class="col-md-3">
                <label asp-for="Date" class="form-label">Date</label>
                <input asp-for="Date" class="form-control" max="@today" required
                       data-error-label="Date" />
            </div>
            <div class="col-md-4">
                <label asp-for="Branch" class="form-label"></label>
                <select asp-for="Branch" class="form-select" id="branchSelect" required data-error-label="Branch">
                    <option value="">-- Select --</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b">@b</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Assigned SQ staff</label>
                <input class="form-control" id="assignedPartner" value="@Model.AssignedPartner" readonly />
            </div>
        </div>
    </div>

    <div class="sq-panel sq-frame mb-4">
        <div class="sq-step">
            <span class="sq-step-num">02</span>
            <h2>Branch feedback</h2>
            <span class="sq-step-rule"></span>
            <span class="sq-step-note">Optional — at least one rating required</span>
        </div>
        <div class="row g-3">
            <div class="col-md-2">
                <label asp-for="BranchRating" class="form-label"></label>
                <select asp-for="BranchRating" class="form-select">
                    <option value="0">Not rated</option>
                    <option value="1">1 - Very Poor</option>
                    <option value="2">2 - Poor</option>
                    <option value="3">3 - Fair</option>
                    <option value="4">4 - Good</option>
                    <option value="5">5 - Excellent</option>
                </select>
            </div>
            <div class="col-md-10">
                <label asp-for="BranchComment" class="form-label"></label>
                <input asp-for="BranchComment" class="form-control js-comment"
                       pattern="[A-Za-z0-9 &amp;+#]*"
                       data-error-label="Branch comment"
                       title="Letters, numbers, spaces, and the symbols & + # only" />
            </div>
        </div>
    </div>

    <div class="sq-panel sq-frame">
        <div class="sq-step">
            <span class="sq-step-num">03</span>
            <h2>Staff feedback</h2>
            <span class="sq-step-rule"></span>
            <span class="sq-step-note">Optional</span>
        </div>
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="StaffName" class="form-label"></label>
                <input asp-for="StaffName" class="form-control js-letters-only"
                       pattern="[A-Za-z ]*" maxlength="200"
                       data-error-label="Staff name"
                       title="Letters and spaces only" />
            </div>
            <div class="col-md-2">
                <label asp-for="StaffRating" class="form-label"></label>
                <select asp-for="StaffRating" class="form-select">
                    <option value="0">Not rated</option>
                    <option value="1">1 - Very Poor</option>
                    <option value="2">2 - Poor</option>
                    <option value="3">3 - Fair</option>
                    <option value="4">4 - Good</option>
                    <option value="5">5 - Excellent</option>
                </select>
            </div>
            <div class="col-md-7">
                <label asp-for="StaffComment" class="form-label"></label>
                <input asp-for="StaffComment" class="form-control js-comment"
                       pattern="[A-Za-z0-9 &amp;+#]*"
                       data-error-label="Staff comment"
                       title="Letters, numbers, spaces, and the symbols & + # only" />
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 justify-content-end mt-4">
        <button type="reset" class="btn btn-outline-secondary" id="clearBtn">Clear</button>
        <button type="submit" class="btn btn-primary sq-frame sq-frame-light">Save case</button>
    </div>
</form>

@section Scripts {
<script>
    (function () {
        var phoneInput = document.getElementById('customerPhone');
        var dupBox = document.getElementById('dupWarning');
        var branchSelect = document.getElementById('branchSelect');
        var partnerBox = document.getElementById('assignedPartner');
        var clearBtn = document.getElementById('clearBtn');
        var partners = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BranchPartnerMap));

        // Real-time character filtering — strips invalid chars as the user types
        function stripWith(el, allowedRegex) {
            el.addEventListener('input', function () {
                var clean = el.value.split('').filter(function (ch) { return allowedRegex.test(ch); }).join('');
                if (clean !== el.value) {
                    var pos = el.selectionStart - (el.value.length - clean.length);
                    el.value = clean;
                    try { el.setSelectionRange(pos, pos); } catch (e) { /* unsupported on some inputs */ }
                }
            });
        }
        document.querySelectorAll('.js-letters-only').forEach(function (el) { stripWith(el, /[A-Za-z ]/); });
        document.querySelectorAll('.js-digits-only').forEach(function (el) { stripWith(el, /[0-9]/); });
        document.querySelectorAll('.js-comment').forEach(function (el) { stripWith(el, /[A-Za-z0-9 &+#]/); });

        // Branch → partner auto-fill
        if (branchSelect) {
            branchSelect.addEventListener('change', function () {
                partnerBox.value = partners[branchSelect.value] || '';
            });
        }

        // Reset also clears the auto-filled partner and the duplicate warning
        if (clearBtn) {
            clearBtn.addEventListener('click', function () {
                setTimeout(function () {
                    if (partnerBox) partnerBox.value = '';
                    if (dupBox) dupBox.textContent = '';
                }, 0);
            });
        }

        // Duplicate-phone check (only when phone reaches 8 digits)
        if (phoneInput) {
            var timer;
            phoneInput.addEventListener('input', function () {
                clearTimeout(timer);
                timer = setTimeout(function () {
                    var v = phoneInput.value.trim();
                    if (v.length !== 8) { dupBox.textContent = ''; return; }
                    fetch('@Url.Action("CheckDuplicate", "Cases")?phone=' + encodeURIComponent(v))
                        .then(function (r) { return r.json(); })
                        .then(function (data) { dupBox.textContent = data.warning || ''; });
                }, 300);
            });
        }

        // Submit-time validation — mirrors CaseFormViewModel rules client-side
        // so all errors land in the same top summary as the server-side path,
        // in form (DOM) order. Server still validates as defense in depth.
        var form = document.getElementById('caseForm');
        var summary = document.getElementById('validationSummary');
        var today = '@today';
        var branchRatingEl = document.querySelector('[name="BranchRating"]');
        var staffRatingEl  = document.querySelector('[name="StaffRating"]');

        function fieldError(el) {
            var label = el.getAttribute('data-error-label') || el.name || 'Field';
            var value = (el.value || '').trim();
            if (el.hasAttribute('required') && value === '') {
                return label + ' is required.';
            }
            if (value === '') return null; // optional + empty = fine
            var min = el.getAttribute('minlength');
            var max = el.getAttribute('maxlength');
            if (min && max && min === max && value.length !== parseInt(min, 10)) {
                return label + ' must be exactly ' + min + ' characters.';
            }
            var pattern = el.getAttribute('pattern');
            if (pattern) {
                var re = new RegExp('^(?:' + pattern + ')$');
                if (!re.test(value)) {
                    var hint = el.getAttribute('title');
                    return label + (hint ? ' — ' + hint.toLowerCase() : ' is invalid') + '.';
                }
            }
            return null;
        }

        form.addEventListener('submit', function (e) {
            var errors = [];
            summary.innerHTML = '';
            summary.classList.add('validation-summary-valid');
            // Iterate validated inputs/selects in DOM order
            form.querySelectorAll('[data-error-label]').forEach(function (el) {
                var msg = fieldError(el);
                if (msg) errors.push(msg);
            });
            // Compound: date not in future
            var dateEl = document.querySelector('[name="Date"]');
            if (dateEl && dateEl.value && dateEl.value > today) {
                errors.push('Date cannot be in the future.');
            }
            // Compound: at least one rating
            var br = branchRatingEl ? parseInt(branchRatingEl.value || '0', 10) : 0;
            var sr = staffRatingEl  ? parseInt(staffRatingEl.value  || '0', 10) : 0;
            if (br === 0 && sr === 0) {
                errors.push('At least one rating (branch or staff) is required.');
            }
            if (errors.length === 0) return; // let the form submit
            e.preventDefault();
            var ul = '<ul class="validation-summary-errors">';
            errors.forEach(function (m) {
                var safe = m.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                ul += '<li>' + safe + '</li>';
            });
            ul += '</ul>';
            // The server-rendered wrapper starts out "valid", which keeps it hidden —
            // drop that before showing the errors we just found.
            summary.classList.remove('validation-summary-valid');
            summary.innerHTML = ul;
            summary.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    })();
</script>
}
