@model CaseDetailsViewModel
@{
    ViewData["Title"] = $"Case #{Model.Case.CaseNumber}";
}

<div class="sq-page-head">
    <div>
        <div class="sq-kicker">Case record</div>
        <h1 class="sq-title">#@Model.Case.CaseNumber</h1>
    </div>
    <a class="sq-section-link" asp-controller="Cases" asp-action="Index">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
        Back to cases
    </a>
</div>

<div class="sq-panel sq-frame sq-detail-page">
    <partial name="_CaseDetails" model="Model" />
</div>
