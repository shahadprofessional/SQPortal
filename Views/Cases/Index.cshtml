@model CasesListViewModel
@{
    ViewData["Title"] = "Cases";

    bool IsRepeat(FeedbackCase c)
    {
        var phone = (c.CustomerPhone ?? "").Trim();
        if (!string.IsNullOrEmpty(phone) && Model.FlaggedPhones.Contains(phone)) return true;
        var name = (c.CustomerName ?? "").Trim().ToLowerInvariant();
        return !string.IsNullOrEmpty(name) && Model.FlaggedNames.Contains(name);
    }

    string PartnerEmail(string? partner)
    {
        if (string.IsNullOrEmpty(partner)) return string.Empty;
        return Model.PartnerEmails.TryGetValue(partner, out var e) ? e : string.Empty;
    }
    string PartnerFullName(string? partner)
    {
        if (string.IsNullOrEmpty(partner)) return string.Empty;
        return Model.PartnerFullNames.TryGetValue(partner, out var n) ? n : string.Empty;
    }
}

<div class="sq-page-head">
    <div>
        <div class="sq-kicker">Records</div>
        <h1 class="sq-title">Cases</h1>
    </div>
    <div class="sq-page-meta">@Model.Count records</div>
</div>

<div class="d-flex justify-content-end align-items-center gap-2 flex-wrap mb-3">
    <a class="btn btn-outline-secondary" asp-action="ExportCsv"
       asp-route-search="@Model.Search"
       asp-route-month="@Model.Month"
       asp-route-followUpStatus="@Model.FollowUpStatus"
       asp-route-rootCause="@Model.RootCause">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 11l5 5 5-5M4 21h16"></path></svg>
        Export CSV
    </a>
    <a class="btn btn-primary sq-frame sq-frame-light" asp-action="Create">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"></path></svg>
        New case
    </a>
</div>

<form method="get" class="sq-filters">
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Search</label>
            <input class="form-control" name="search" value="@Model.Search" placeholder="Customer, phone, branch, staff, ticket" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Month</label>
            <select class="form-select" name="month">
                <option value="">All</option>
                @foreach (var m in Model.Months)
                {
                    if (m == Model.Month)
                    {
                        <option value="@m" selected>@DisplayHelpers.FormatMonth(m)</option>
                    }
                    else
                    {
                        <option value="@m">@DisplayHelpers.FormatMonth(m)</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Follow-up</label>
            <select class="form-select" name="followUpStatus">
                <option value="">All</option>
                @foreach (var status in Enum.GetValues<FollowUpStatus>())
                {
                    if (Model.FollowUpStatus == status)
                    {
                        <option value="@status" selected>@status</option>
                    }
                    else
                    {
                        <option value="@status">@status</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Root cause</label>
            <select class="form-select" name="rootCause">
                <option value="">All</option>
                @foreach (var r in Model.RootCauseOptions)
                {
                    if (r == Model.RootCause)
                    {
                        <option value="@r" selected>@r</option>
                    }
                    else
                    {
                        <option value="@r">@r</option>
                    }
                }
                @if (Model.RootCause == "Other")
                {
                    <option value="Other" selected>Other</option>
                }
                else
                {
                    <option value="Other">Other</option>
                }
            </select>
        </div>
        <div class="col-md-1 d-flex align-items-end">
            <button class="btn btn-primary w-100" type="submit">Filter</button>
        </div>
    </div>
    <div class="sq-filters-foot">
        <a asp-action="Index">Clear filters</a>
    </div>
</form>

@if (!Model.Cases.Any())
{
    <div class="sq-empty">
        <svg class="sq-empty-icon" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4.3-4.3"></path></svg>
        <div class="sq-empty-title">No cases match these filters</div>
        <div class="sq-empty-sub">Try clearing a filter, or add a new case.</div>
    </div>
}
else
{
    @Html.AntiForgeryToken()
    <div class="sq-table-wrap">
        <table class="table table-hover align-middle mb-0 sq-centered">
            <thead>
                <tr>
                    <th>Case</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Phone</th>
                    <th>Branch</th>
                    <th>Branch ★</th>
                    <th>Staff</th>
                    <th>Staff ★</th>
                    <th>SQ staff</th>
                    <th>Status</th>
                    <th>SLA</th>
                    <th class="text-end">Age</th>
                    <th>Root causes</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Cases)
                {
                    var c = row.Case;
                    var partnerEmail = PartnerEmail(c.BusinessPartner);
                    var partnerFullName = PartnerFullName(c.BusinessPartner);
                    var mailto = string.IsNullOrEmpty(partnerEmail) ? string.Empty : DisplayHelpers.BuildLowRatingMailto(c, partnerEmail, partnerFullName);
                    var rowClasses = (row.SlaBreached ? "tr-breached" : "") + (IsRepeat(c) ? " tr-repeat" : "");
                    <tr data-case-id="@c.Id" class="@rowClasses.Trim()">
                        <td class="sq-id">@c.CaseNumber</td>
                        <td class="sq-num">@c.Date.ToString("yyyy-MM-dd")</td>
                        <td>
                            @c.CustomerName
                            @if (IsRepeat(c))
                            {
                                <span class="repeat-marker" title="Repeat customer">↻</span>
                            }
                        </td>
                        <td class="sq-num">@c.CustomerPhone</td>
                        <td>@c.Branch</td>
                        <td>@DisplayHelpers.Stars(c.BranchRating)</td>
                        <td>@c.StaffName</td>
                        <td>@DisplayHelpers.Stars(c.StaffRating)</td>
                        <td>@c.BusinessPartner</td>
                        <td>
                            <span class="badge-sq @(c.FollowUpStatus == FollowUpStatus.Completed ? "badge-sq-completed" : "badge-sq-pending")">
                                @c.FollowUpStatus
                            </span>
                        </td>
                        <td>
                            @if (row.SlaBreached)
                            {
                                <span class="badge-sq badge-sq-breached">Breached</span>
                            }
                            else
                            {
                                <span class="sq-cell-muted sq-num">Due @c.DueDate.ToString("MM-dd")</span>
                            }
                        </td>
                        <td class="text-end sq-num">@row.AgeDays d</td>
                        <td class="sq-cell-muted">@string.Join(", ", c.RootCauses)</td>
                        <td>
                            <div class="sq-row-actions">
                                <a class="btn btn-sm btn-outline-secondary btn-row" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                                @if (!string.IsNullOrEmpty(mailto))
                                {
                                    <a class="btn btn-sm btn-outline-secondary btn-row js-email-btn @(c.EmailSent ? "btn-email-sent" : "")"
                                       href="@mailto" data-case-id="@c.Id" title="@(c.EmailSent ? "Email already sent" : "Send partner email")">
                                        @(c.EmailSent ? "Sent" : "Email")
                                    </a>
                                }
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post"
                                      onsubmit="return confirm('Delete this case? This cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger btn-row" type="submit">Del</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
<script>
    (function () {
        var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
        if (!tokenEl) return;
        var token = tokenEl.value;
        document.querySelectorAll('.js-email-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = btn.getAttribute('data-case-id');
                if (!id) return;
                // Optimistic update — match the prototype's immediate-feedback behavior
                btn.classList.add('btn-email-sent');
                btn.textContent = 'Sent';
                btn.setAttribute('title', 'Email already sent');
                var body = new URLSearchParams({ id: id, __RequestVerificationToken: token });
                fetch('@Url.Action("MarkEmailSent", "Cases")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: body.toString()
                }).catch(function () { /* leave UI optimistic; will reconcile on next page load */ });
            });
        });
    })();
</script>
}
