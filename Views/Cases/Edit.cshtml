@model EditCaseViewModel
@{
    ViewData["Title"] = "Edit Case";
}

<div class="sq-page-head">
    <div>
        <div class="sq-kicker">Case record</div>
        <h1 class="sq-title">Edit case <span class="sq-count">#@Model.CaseNumber</span></h1>
    </div>
    <div class="sq-page-meta">SLA: 1 working day from the feedback date</div>
</div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CaseNumber" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="sq-panel sq-frame mb-4">
        <div class="sq-step">
            <span class="sq-step-num">01</span>
            <h2>Customer &amp; case</h2>
            <span class="sq-step-rule"></span>
        </div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="CustomerName" class="form-label"></label>
                <input asp-for="CustomerName" class="form-control js-letters-only"
                       pattern="@FieldPatterns.Name" maxlength="200" required
                       title="Letters and spaces only" />
                <span asp-validation-for="CustomerName" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="CustomerPhone" class="form-label"></label>
                <input asp-for="CustomerPhone" class="form-control js-digits-only"
                       inputmode="numeric" pattern="@FieldPatterns.Phone" minlength="8" maxlength="8" required
                       title="Exactly 8 digits" />
                <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="TicketNumber" class="form-label"></label>
                <input asp-for="TicketNumber" class="form-control js-alnum"
                       pattern="@FieldPatterns.AlphanumericOptional" maxlength="60"
                       title="Letters and numbers only" />
                <span asp-validation-for="TicketNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Date" class="form-label"></label>
                <input asp-for="Date" class="form-control" id="caseDate" />
            </div>
            <div class="col-md-4">
                <label asp-for="Branch" class="form-label"></label>
                <select asp-for="Branch" class="form-select">
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b">@b</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="BusinessPartner" class="form-label"></label>
                <select asp-for="BusinessPartner" class="form-select">
                    @foreach (var p in Model.Partners)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="DueDate" class="form-label"></label>
                <input asp-for="DueDate" class="form-control js-not-before-date"
                       title="Cannot be before the case date" />
                <span asp-validation-for="DueDate" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="sq-panel sq-frame mb-4">
        <div class="sq-step">
            <span class="sq-step-num">02</span>
            <h2>Ratings</h2>
            <span class="sq-step-rule"></span>
        </div>
        <div class="row g-3">
            <div class="col-md-2">
                <label asp-for="BranchRating" class="form-label"></label>
                <select asp-for="BranchRating" class="form-select">
                    <option value="0">Not rated</option>
                    <option value="1">1 - Very Poor</option>
                    <option value="2">2 - Poor</option>
                    <option value="3">3 - Fair</option>
                    <option value="4">4 - Good</option>
                    <option value="5">5 - Excellent</option>
                </select>
            </div>
            <div class="col-md-10">
                <label asp-for="BranchComment" class="form-label"></label>
                <input asp-for="BranchComment" class="form-control js-comment"
                       pattern="@FieldPatterns.TextOptional"
                       title="Letters, numbers and spaces only" />
                <span asp-validation-for="BranchComment" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="StaffName" class="form-label"></label>
                <input asp-for="StaffName" class="form-control js-letters-only"
                       pattern="@FieldPatterns.NameOptional" maxlength="200"
                       title="Letters and spaces only" />
                <span asp-validation-for="StaffName" class="text-danger small"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="StaffRating" class="form-label"></label>
                <select asp-for="StaffRating" class="form-select">
                    <option value="0">Not rated</option>
                    <option value="1">1 - Very Poor</option>
                    <option value="2">2 - Poor</option>
                    <option value="3">3 - Fair</option>
                    <option value="4">4 - Good</option>
                    <option value="5">5 - Excellent</option>
                </select>
            </div>
            <div class="col-md-7">
                <label asp-for="StaffComment" class="form-label"></label>
                <input asp-for="StaffComment" class="form-control js-comment"
                       pattern="@FieldPatterns.TextOptional"
                       title="Letters, numbers and spaces only" />
                <span asp-validation-for="StaffComment" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="sq-panel sq-frame mb-4">
        <div class="sq-step">
            <span class="sq-step-num">03</span>
            <h2>Follow-up</h2>
            <span class="sq-step-rule"></span>
        </div>
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="FollowUpStatus" class="form-label"></label>
                <select asp-for="FollowUpStatus" class="form-select">
                    @foreach (var status in Enum.GetValues<FollowUpStatus>())
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="FollowUpDate" class="form-label"></label>
                <input asp-for="FollowUpDate" class="form-control js-not-before-date"
                       title="Cannot be before the case date" />
                <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="FollowUpNotes" class="form-label"></label>
                <input asp-for="FollowUpNotes" class="form-control js-comment"
                       pattern="@FieldPatterns.TextOptional"
                       title="Letters, numbers and spaces only" />
                <span asp-validation-for="FollowUpNotes" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="sq-panel sq-frame">
        <div class="sq-step">
            <span class="sq-step-num">04</span>
            <h2>Validation &amp; root causes</h2>
            <span class="sq-step-rule"></span>
        </div>
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="CaseValidation" class="form-label"></label>
                <select asp-for="CaseValidation" class="form-select">
                    @foreach (var v in Enum.GetValues<CaseValidation>())
                    {
                        <option value="@v">@DisplayHelpers.ValidationLabel(v)</option>
                    }
                </select>
            </div>
            <div class="col-md-12">
                <label class="form-label">Root causes</label>
                <div class="sq-chips">
                    @foreach (var rc in Model.RootCauseOptions)
                    {
                        var checkedAttr = Model.RootCauses.Contains(rc);
                        <label class="sq-chip">
                            <input type="checkbox" name="RootCauses" value="@rc" id="rc_@rc.GetHashCode()" @(checkedAttr ? "checked" : "") />
                            <span>@rc</span>
                        </label>
                    }
                </div>
            </div>
            <div class="col-md-12">
                <label asp-for="ValidationNotes" class="form-label"></label>
                <textarea asp-for="ValidationNotes" class="form-control js-comment" rows="2"
                          title="Letters, numbers and spaces only"></textarea>
                <span asp-validation-for="ValidationNotes" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 justify-content-end mt-4">
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary sq-frame sq-frame-light">Save changes</button>
    </div>
</form>

@section Scripts {
<script>
    (function () {
        // Same character filtering as the add form — strips as you type.
        function stripWith(el, allowedRegex) {
            el.addEventListener('input', function () {
                var clean = el.value.split('').filter(function (ch) { return allowedRegex.test(ch); }).join('');
                if (clean !== el.value) {
                    var pos = el.selectionStart - (el.value.length - clean.length);
                    el.value = clean;
                    try { el.setSelectionRange(pos, pos); } catch (e) { /* unsupported on some inputs */ }
                }
            });
        }
        document.querySelectorAll('.js-letters-only').forEach(function (el) { stripWith(el, /[A-Za-z ]/); });
        document.querySelectorAll('.js-digits-only').forEach(function (el) { stripWith(el, /[0-9]/); });
        document.querySelectorAll('.js-alnum').forEach(function (el) { stripWith(el, /[A-Za-z0-9]/); });
        document.querySelectorAll('.js-comment').forEach(function (el) { stripWith(el, /[A-Za-z0-9 ]/); });

        // Due date and follow-up date hang off the case date: the picker cannot go
        // earlier. Existing values are left alone — the server reports those.
        var caseDate = document.getElementById('caseDate');
        var dependents = document.querySelectorAll('.js-not-before-date');
        if (caseDate) {
            var applyFloor = function () {
                dependents.forEach(function (el) { el.min = caseDate.value || ''; });
            };
            caseDate.addEventListener('change', applyFloor);
            applyFloor();
        }
    })();
</script>
}
