@model WeeklyReportViewModel
@{
    ViewData["Title"] = "Weekly Report";
    string StarsHtml(int n) => n > 0 ? new string('★', n) + new string('☆', 5 - n) : "—";
}

<div class="sq-page-head">
    <div>
        <div class="sq-kicker">Outbound</div>
        <h1 class="sq-title">Weekly branch report</h1>
    </div>
    <div class="sq-page-meta">Period @Model.Start.ToString("yyyy-MM-dd") → @Model.End.ToString("yyyy-MM-dd")</div>
</div>

<div class="sq-weekly-strip">
    <div class="sq-weekly-stats">
        <div>
            <div class="sq-weekly-value">@Model.TotalPoorCases</div>
            <div class="sq-weekly-label">Poor-rated cases</div>
        </div>
        <div>
            <div class="sq-weekly-value">@Model.Branches.Count</div>
            <div class="sq-weekly-label">Branches</div>
        </div>
    </div>
    <form method="get" class="d-flex gap-2 align-items-center flex-wrap">
        <select name="range" class="form-select w-auto" onchange="this.form.submit()">
            @foreach (var r in Model.RangeOptions)
            {
                if (r.Value == Model.Range)
                {
                    <option value="@r.Value" selected>@r.Label</option>
                }
                else
                {
                    <option value="@r.Value">@r.Label</option>
                }
            }
        </select>
        @if (Model.TotalPoorCases > 0)
        {
            <a class="btn btn-warning" href="@Model.CombinedMailtoLink">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18v12H3zM3 6l9 7 9-7"></path></svg>
                Send combined
            </a>
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#combinedPreview">Preview</button>
        }
    </form>
</div>
<div class="sq-weekly-note">Auto-generated from cases rated 1–2★ that are completed and validated</div>

@if (Model.TotalPoorCases > 0)
{
    <div class="collapse mb-3" id="combinedPreview">
        <div class="sq-panel-flat">
            <textarea class="sq-preview" rows="14" readonly>@Model.CombinedPreviewText</textarea>
        </div>
    </div>
}

@if (Model.TotalPoorCases == 0)
{
    <div class="sq-empty sq-empty-success">
        <svg class="sq-empty-icon" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
        <div class="sq-empty-title">Nothing to report this period</div>
        <div class="sq-empty-sub">No completed, validated 1–2★ cases in this date range.</div>
    </div>
}
else
{
    var brIdx = 0;
    foreach (var b in Model.Branches)
    {
        var previewId = $"preview-{brIdx}";
        <div class="sq-branch-card">
            <div class="sq-branch-head">
                <div>
                    <div class="sq-branch-name">@b.Branch</div>
                    <div class="sq-branch-sub">
                        SQ staff: <strong>@b.Partner</strong>
                        @if (!string.IsNullOrEmpty(b.PartnerEmail))
                        {
                            <span> · @b.PartnerEmail</span>
                        }
                    </div>
                </div>
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <span class="badge-sq badge-sq-gold">@b.PoorCaseCount feedbacks</span>
                    <a class="btn btn-sm btn-primary" href="@b.MailtoLink">Send report</a>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#@previewId">Preview</button>
                </div>
            </div>

            @if (b.StaffMentioned.Count > 0)
            {
                <div class="sq-branch-staff">
                    Staff mentioned: <strong>@string.Join(" · ", b.StaffMentioned)</strong>
                </div>
            }

            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Branch ★</th>
                        <th>Staff</th>
                        <th>Staff ★</th>
                        <th>Root cause</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in b.Cases)
                    {
                        var rcs = (c.RootCauses != null && c.RootCauses.Count > 0)
                            ? c.RootCauses
                            : (string.IsNullOrEmpty(c.ValidityStatus) ? new List<string>() : new List<string> { c.ValidityStatus });
                        <tr>
                            <td class="sq-num sq-cell-muted">@c.Date.ToString("yyyy-MM-dd")</td>
                            <td class="sq-stars">@(c.BranchRating > 0 ? StarsHtml(c.BranchRating) : "—")</td>
                            <td>@(c.StaffName ?? "—")</td>
                            <td class="sq-stars">@(c.StaffRating > 0 ? StarsHtml(c.StaffRating) : "—")</td>
                            <td>
                                @if (rcs.Count > 0)
                                {
                                    foreach (var r in rcs)
                                    {
                                        <span class="badge-sq badge-sq-tint me-1">@r</span>
                                    }
                                }
                                else
                                {
                                    <span class="sq-cell-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="badge-sq @(c.FollowUpStatus == FollowUpStatus.Completed ? "badge-sq-completed" : "badge-sq-pending")">
                                    @c.FollowUpStatus
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="collapse" id="@previewId">
                <textarea class="sq-preview" rows="12" readonly>@b.PreviewText</textarea>
            </div>
        </div>
        brIdx++;
    }
}
