@model SettingsViewModel
@{
    ViewData["Title"] = "Settings";

    // Rendered for each row's two dropdowns; "—" when the roster is empty.
    string SelectedOrFirst(string current, IEnumerable<string> options) =>
        !string.IsNullOrEmpty(current) ? current : (options.FirstOrDefault() ?? string.Empty);

    var managerNames = Model.Managers.Select(m => m.Name).ToList();
    var partnerNames = Model.Partners.Select(p => p.Name).ToList();
}

<div class="sq-page-head">
    <div>
        <div class="sq-kicker">Configuration</div>
        <h1 class="sq-title">Settings</h1>
    </div>
    <div class="sq-page-meta">
        @Model.Branches.Count branches · @Model.Managers.Count managers · @Model.Partners.Count SQ staff
    </div>
</div>

<!-- ============ Branches: name + both owners in one row ============ -->
<div class="sq-panel sq-frame mb-4">
    <div class="sq-panel-head">
        <h2>Branches</h2>
        <span class="sq-panel-note">Name, manager and SQ owner — one row each. Save applies all three.</span>
    </div>

    <form asp-action="AddBranch" method="post" class="sq-branch-row sq-branch-add">
        @Html.AntiForgeryToken()
        <input class="form-control form-control-sm" name="name" placeholder="New branch name" required maxlength="100" aria-label="New branch name" />
        <select class="form-select form-select-sm" name="manager" aria-label="Branch manager">
            @foreach (var m in managerNames)
            {
                <option value="@m">@m</option>
            }
        </select>
        <select class="form-select form-select-sm" name="partner" aria-label="SQ staff">
            @foreach (var p in partnerNames)
            {
                <option value="@p">@p</option>
            }
        </select>
        <button class="btn btn-sm btn-primary" type="submit">Add</button>
    </form>

    <div class="sq-branch-grid">
        <div class="sq-branch-grid-head">
            <div>Branch name</div>
            <div>Branch manager</div>
            <div>SQ staff</div>
            <div></div>
        </div>

        @if (!Model.Branches.Any())
        {
            <div class="sq-panel-note py-3">No branches yet — add one above.</div>
        }

        @foreach (var b in Model.Branches)
        {
            var selectedManager = SelectedOrFirst(b.Manager, managerNames);
            var selectedPartner = SelectedOrFirst(b.Partner, partnerNames);

            <form asp-action="UpdateBranch" method="post" class="sq-branch-row">
                @Html.AntiForgeryToken()
                <input type="hidden" name="oldName" value="@b.Name" />
                @* Delete posts this same form, and it binds "name" *@
                <input type="hidden" name="name" value="@b.Name" />

                <input class="form-control form-control-sm" name="newName" value="@b.Name" required maxlength="100" aria-label="Branch name" />

                <select class="form-select form-select-sm" name="manager" aria-label="Branch manager">
                    @if (!managerNames.Any())
                    {
                        <option value="">— none on file —</option>
                    }
                    @foreach (var m in managerNames)
                    {
                        if (m == selectedManager)
                        {
                            <option value="@m" selected>@m</option>
                        }
                        else
                        {
                            <option value="@m">@m</option>
                        }
                    }
                </select>

                <select class="form-select form-select-sm" name="partner" aria-label="SQ staff">
                    @if (!partnerNames.Any())
                    {
                        <option value="">— none on file —</option>
                    }
                    @foreach (var p in partnerNames)
                    {
                        if (p == selectedPartner)
                        {
                            <option value="@p" selected>@p</option>
                        }
                        else
                        {
                            <option value="@p">@p</option>
                        }
                    }
                </select>

                <div class="sq-staff-actions">
                    <button class="btn btn-sm btn-primary" type="submit">Save</button>
                    @* Same form, different target — a nested <form> for delete is not valid HTML *@
                    <button class="btn btn-sm btn-outline-danger" type="submit" formnovalidate
                            formaction="@Url.Action("DeleteBranch", "Settings")"
                            onclick="return confirm('Delete branch &quot;@b.Name&quot;? This is blocked if any cases reference it.');">
                        Delete
                    </button>
                </div>
            </form>
        }
    </div>
</div>

<!-- ============ Managers ============ -->
<div class="sq-panel sq-frame mb-4">
    <div class="sq-panel-head">
        <h2>Managers staff</h2>
        <span class="sq-panel-note">Every field is editable. Renaming or removing someone moves their branches only.</span>
    </div>

    <form asp-action="AddManager" method="post" class="row g-3 mb-3">
        @Html.AntiForgeryToken()
        <div class="col-md-2">
            <input class="form-control" name="name" placeholder="Key" required maxlength="40" />
        </div>
        <div class="col-md-4">
            <input class="form-control" name="fullName" placeholder="Full name" maxlength="200" />
        </div>
        <div class="col-md-4">
            <input class="form-control" name="email" type="email" placeholder="Email" maxlength="200" />
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-primary" type="submit">Add manager</button>
        </div>
    </form>

    <div class="sq-staff-grid">
        <div class="sq-staff-head">
            <div>Key</div>
            <div>Full name</div>
            <div>Email</div>
            <div></div>
        </div>
        @foreach (var m in Model.Managers)
        {
            <form asp-action="UpdateManager" method="post" class="sq-staff-row">
                @Html.AntiForgeryToken()
                <input type="hidden" name="name" value="@m.Name" />
                <input class="form-control form-control-sm" name="newName" value="@m.Name" required maxlength="40" aria-label="Key" />
                <input class="form-control form-control-sm" name="fullName" value="@m.FullName" maxlength="200" aria-label="Full name" />
                <input class="form-control form-control-sm" name="email" type="email" value="@m.Email" maxlength="200" aria-label="Email" />
                <div class="sq-staff-actions">
                    <button class="btn btn-sm btn-primary" type="submit">Save</button>
                    <button class="btn btn-sm btn-outline-danger" type="submit" formnovalidate
                            formaction="@Url.Action("DeleteManager", "Settings")"
                            onclick="return confirm('Remove &quot;@m.Name&quot; from the managers? Their branches pass to whoever is left.');">
                        Delete
                    </button>
                </div>
            </form>
        }
    </div>
</div>

<!-- ============ SQ staff ============ -->
<div class="sq-panel sq-frame mb-4">
    <div class="sq-panel-head">
        <h2>SQ staff</h2>
        <span class="sq-panel-note">Every field is editable. Renaming or removing someone moves their branches only — past cases keep the name they were handled under.</span>
    </div>

    <form asp-action="AddPartner" method="post" class="row g-3 mb-3">
        @Html.AntiForgeryToken()
        <div class="col-md-2">
            <input class="form-control" name="name" placeholder="Key" required maxlength="40" />
        </div>
        <div class="col-md-4">
            <input class="form-control" name="fullName" placeholder="Full name" maxlength="200" />
        </div>
        <div class="col-md-4">
            <input class="form-control" name="email" type="email" placeholder="Email" maxlength="200" />
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-primary" type="submit">Add staff</button>
        </div>
    </form>

    <div class="sq-staff-grid">
        <div class="sq-staff-head">
            <div>Key</div>
            <div>Full name</div>
            <div>Email</div>
            <div></div>
        </div>
        @foreach (var p in Model.Partners)
        {
            <form asp-action="UpdatePartner" method="post" class="sq-staff-row">
                @Html.AntiForgeryToken()
                <input type="hidden" name="name" value="@p.Name" />
                <input class="form-control form-control-sm" name="newName" value="@p.Name" required maxlength="40" aria-label="Key" />
                <input class="form-control form-control-sm" name="fullName" value="@p.FullName" maxlength="200" aria-label="Full name" />
                <input class="form-control form-control-sm" name="email" type="email" value="@p.Email" maxlength="200" aria-label="Email" />
                <div class="sq-staff-actions">
                    <button class="btn btn-sm btn-primary" type="submit">Save</button>
                    <button class="btn btn-sm btn-outline-danger" type="submit" formnovalidate
                            formaction="@Url.Action("DeletePartner", "Settings")"
                            onclick="return confirm('Remove &quot;@p.Name&quot; from the SQ team? Past cases keep their name; their branches become unassigned.');">
                        Delete
                    </button>
                </div>
            </form>
        }
    </div>
</div>
