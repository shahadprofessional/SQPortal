@model AuditViewModel
@{
    ViewData["Title"] = "Audit";
}

<div class="sq-page-head">
    <div>
        <div class="sq-kicker">Accountability</div>
        <h1 class="sq-title">Audit trail</h1>
    </div>
    <div class="sq-page-meta">@Model.TotalItems recorded action@(Model.TotalItems == 1 ? "" : "s")</div>
</div>

@if (!Model.Items.Any())
{
    <div class="sq-empty">
        <svg class="sq-empty-icon" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5h6M9 5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2"></path></svg>
        <div class="sq-empty-title">No recorded actions yet</div>
        <div class="sq-empty-sub">Creates, edits, deletions, emails and exports appear here.</div>
    </div>
}
else
{
    <div class="sq-panel sq-frame">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 175px;">Time (UTC)</th>
                    <th style="width: 160px;">User</th>
                    <th style="width: 140px;">Action</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Items)
                {
                    <tr>
                        <td class="sq-num sq-cell-muted text-nowrap">@entry.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@entry.User</td>
                        <td><span class="badge-sq badge-sq-tint">@entry.Action</span></td>
                        <td class="sq-cell-muted">@entry.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Audit pages" class="mt-3">
            <ul class="pagination pagination-sm mb-0 justify-content-end">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)">Prev</a>
                </li>
                <li class="page-item disabled"><span class="page-link">@Model.Page / @Model.TotalPages</span></li>
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
}
