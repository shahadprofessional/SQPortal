{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SQPortal;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  // Active Directory link — read by the commented AD block in Program.cs
  // (marked "/////////remove when you want to link AD\\\\\\\\\\").
  // Set to the AD group whose members may use the portal, in DOMAIN\Group
  // form, e.g. "CONTOSO\\SQ Portal Users". Until AD is linked the app uses
  // the click-to-sign-in test users instead and this value is ignored.
  "Auth": {
    "AllowedAdGroup": ""
  },
  // Outbound email. FromAddress is the mailbox every portal email (partner
  // notifications, weekly branch reports) is sent from — a placeholder for
  // now, change it together with the SMTP settings when the real mailbox
  // exists. Until SmtpHost is set, pressing Send shows a clear "not
  // configured" message instead of sending. Keep real credentials out of this
  // file — use environment variables (Mail__SmtpUsername, Mail__SmtpPassword)
  // or "dotnet user-secrets".
  "Mail": {
    "FromAddress": "SQChangeLaterEmail@Example.com",
    "FromDisplayName": "SQ Service Quality Team",
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseStartTls": true,
    "SmtpUsername": "",
    "SmtpPassword": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
