{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SQPortal;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  // Sign-in credentials. Set real values via environment variables
  // (Auth__Username, Auth__Password) or "dotnet user-secrets" — never commit
  // them here. Auth:PasswordHash ("pbkdf2$<iterations>$<saltBase64>$<hashBase64>")
  // is preferred over the plain Auth:Password. With nothing set, sign-in
  // always fails and the portal stays sealed.
  "Auth": {
    "Username": "",
    "Password": "",
    "PasswordHash": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
