{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SQPortal;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  // AD group allowed into the portal (DOMAIN\Group form, e.g.
  // "CONTOSO\\SQ Portal Users"). Read by the commented AD block in Program.cs
  // (marked "/////////remove when you want to link AD\\\\\\\\\\"); ignored
  // while the test sign-in is active.
  "Auth": {
    "AllowedAdGroup": ""
  },
  // Branch managers come from Active Directory and are read-only in the
  // portal: their names, emails and the branch each one runs are copied from
  // the groups below and cannot be typed in. Moving someone between branches,
  // or off them entirely, is done in AD — the portal follows within
  // SyncIntervalMinutes and keeps the previous branch's history untouched.
  //
  // Enabled: false until IT Security has handed over the real group names.
  //   While it is false nothing is read and the stored roster is left alone.
  // Server: domain controller or domain to query; empty means the machine's
  //   own domain, which is the normal case on a domain-joined server.
  // SearchBase: base DN for the lookups, e.g. "DC=contoso,DC=local"; empty
  //   means the domain root.
  // UsernameSuffix: the suffix the managers' usernames carry ("@contoso.com").
  //   A member whose username ends in something else is flagged in Settings.
  // SyncIntervalMinutes: how often the groups are re-read (minimum 5).
  // BranchGroups: one entry per AD group that holds branch managers, and the
  //   branch its members manage. Branch must match the branch name in
  //   Settings exactly. There are about six groups, named alphabetically;
  //   replace every CHANGEME below with the real name, delete the entries you
  //   do not need, and add more if there are more branches.
  "Ad": {
    "Enabled": false,
    "Server": "",
    "SearchBase": "",
    "UsernameSuffix": "@changeMeLater",
    "SyncIntervalMinutes": 60,
    "BranchGroups": [
      { "Group": "CHANGEME-BranchManagers-A", "Branch": "" },
      { "Group": "CHANGEME-BranchManagers-B", "Branch": "" },
      { "Group": "CHANGEME-BranchManagers-C", "Branch": "" },
      { "Group": "CHANGEME-BranchManagers-D", "Branch": "" },
      { "Group": "CHANGEME-BranchManagers-E", "Branch": "" },
      { "Group": "CHANGEME-BranchManagers-F", "Branch": "" }
    ]
  },
  // Transport security and key storage.
  // RequireHttps: keep true when the server has an HTTPS binding
  // (recommended). Set false ONLY for plain-http intranet hosting with no
  // certificate — it relaxes the Secure flag on cookies and disables the
  // https redirect; leaving it true on an http-only server makes sign-in
  // silently impossible.
  // DataProtectionKeysFolder: where the cookie/antiforgery encryption keys
  // live. Must survive restarts and deployments; empty means <app>/keys.
  // The service account needs write access to it.
  "Security": {
    "RequireHttps": true,
    "DataProtectionKeysFolder": ""
  },
  // Outbound email. FromAddress is the mailbox every portal email is sent
  // from — a placeholder until the real mailbox exists. While SmtpHost is
  // empty, Send shows a "not configured" message instead of sending. Real
  // credentials belong in environment variables (Mail__SmtpUsername,
  // Mail__SmtpPassword) or user secrets, not in this file.
  "Mail": {
    "FromAddress": "SQChangeLaterEmail@Example.com",
    "FromDisplayName": "SQ Service Quality Team",
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseStartTls": true,
    "SmtpUsername": "",
    "SmtpPassword": ""
  },
  // SLA clock. TimeZone is the business time zone "today" is computed in
  // (e.g. "Arabian Standard Time" on Windows); empty means the server's local
  // zone, which is wrong on cloud servers running UTC. WeekendDays are the
  // non-working days for SLA purposes.
  "Sla": {
    "TimeZone": "",
    "WeekendDays": [ "Friday", "Saturday" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Without this, every SQL statement is logged on every page view.
      // Warnings and errors from the database layer still come through.
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    // Daily log files (sqportal-<date>.log) so server-side failures stay
    // diagnosable — the console is invisible under IIS or a Windows service.
    // Folder is relative to the app root unless an absolute path is given;
    // the service account needs write access to it. Files older than
    // RetainDays are deleted automatically (0 keeps them forever).
    "File": {
      "Enabled": true,
      "Folder": "Logs",
      "MinimumLevel": "Information",
      "RetainDays": 90
    }
  },
  // Set to the site's real internal hostname in each environment, e.g.
  // "sqportal.company.local" — "*" answers to any host name.
  "AllowedHosts": "*"
}
